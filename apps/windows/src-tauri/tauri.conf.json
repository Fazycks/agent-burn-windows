{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Burn",
  "version": "0.1.17",
  "identifier": "dev.melvynx.agent-burn.windows",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Agent Burn",
    "category": "DeveloperTool",
    "shortDescription": "Agent Burn for Windows",
    "longDescription": "See what your AI coding agents burn: API-equivalent spend, tokens, and live subscription quotas for Codex, Claude Code, Cursor and more.",
    "copyright": "MIT licensed · Based on ccusage",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/agent-burn.exe": "agent-burn.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
